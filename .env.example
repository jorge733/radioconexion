## Dirección Meteorológica de Chile (mantener privados; nunca en el navegador)
DMC_API_USER=tu-correo-registrado-en-dmc
DMC_API_TOKEN=tu-token-personal-dmc
# Estación DMC con modelo WRF. 330021 es Santiago/Quinta Normal; cámbiala si corresponde.
DMC_STATION_CODE=330021

## Comunidad: aviso por correo de solicitudes nuevas (Resend). Nunca en el navegador.
RESEND_API_KEY=re_CAMBIA_ESTA_CLAVE
# Opcionales (estos son los valores por defecto):
COMMUNITY_ADMIN_EMAIL=sabenedettoa@benedettowebs.cl
# El dominio del remitente debe estar verificado en Resend.
COMMUNITY_EMAIL_FROM="Radio Conexión <comunidad@radioconexionweb.com>"
