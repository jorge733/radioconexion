FIREBASE_PROJECT_ID=radio-conexion-e924e
# Debe coincidir con storageBucket en firebase-config.js.
FIREBASE_STORAGE_BUCKET=radio-conexion-e924e.firebasestorage.app
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/TU_SCRIPT/exec
# Usa una cadena aleatoria larga. Guárdala también como propiedad de script
# SUSCRIPTORES_SHARED_SECRET en Google Apps Script.
APPS_SCRIPT_SHARED_SECRET=CAMBIA_ESTE_SECRETO
## Dirección Meteorológica de Chile (mantener privados; nunca en el navegador)
DMC_API_USER=tu-correo-registrado-en-dmc
DMC_API_TOKEN=tu-token-personal-dmc
# Estación DMC con modelo WRF. 330021 es Santiago/Quinta Normal; cámbiala si corresponde.
DMC_STATION_CODE=330021

## Notificaciones del navegador (Firebase Cloud Messaging)
# Correo de la cuenta de servicio de Firebase (Firebase Console > Configuración > Cuentas de servicio).
FIREBASE_SERVICE_ACCOUNT_EMAIL=firebase-adminsdk-xxxxx@radio-conexion-e924e.iam.gserviceaccount.com
# Clave privada de esa cuenta, en una sola línea o conservando los saltos como \n.
FIREBASE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nCAMBIA_ESTA_CLAVE\n-----END PRIVATE KEY-----\n"
# Correo autorizado para publicar avisos desde el sitio.
RADIO_ADMIN_EMAIL=tu-correo@radioconexionweb.com

## Boletín por correo (Resend). Nunca pongas la clave en el navegador.
# Resend > API Keys, con permiso "Full access" (debe gestionar contactos y envíos).
RESEND_API_KEY=re_CAMBIA_ESTA_CLAVE
# Resend > Audience > Segments: id del segmento "Boletín Radio Conexión".
RESEND_SEGMENT_ID=00000000-0000-0000-0000-000000000000
# Remitente; el dominio debe estar verificado en Resend.
NEWSLETTER_FROM="Radio Conexión <boletin@radioconexionweb.com>"
# Opcional: dónde llegan las respuestas al boletín.
NEWSLETTER_REPLY_TO=
