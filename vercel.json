{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/blog-posts",
      "destination": "/api/member-action?route=blog-posts"
    },
    {
      "source": "/api/episodes",
      "destination": "/api/member-action?route=episodes"
    }
  ],
  "redirects": [
    {
      "source": "/studio",
      "destination": "/studio/",
      "permanent": true
    },
    {
      "source": "/",
      "destination": "/inicio",
      "permanent": true
    },
    {
      "source": "/(blog|episodios|noticias|noticias-del-dia)(\\.html)?",
      "destination": "/inicio",
      "permanent": false
    }
  ]
}
